DB_HOST=localhost
DB_PORT=5432
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_NAME=pet_management
DB_SSL=false
# Production: DB_SSL=true and a deployed, verified AWS RDS CA bundle file.
# DB_SSL_CA_FILE=/var/app/current/certs/rds-ca-bundle.pem

# Local: npm run setup-auth securely generates this in the ignored .env.
AUTH_SECRET=replace-with-a-strong-secret
NODE_ENV=development
PORT=3000
# Production only; default 2 for ALB -> nginx -> Express. Ignored in development.
TRUST_PROXY_HOPS=2
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Production requires NODE_ENV=production and exact HTTPS frontend origins.
# FRONTEND_ORIGIN=https://admin.petgroom.my
# Use the actual RDS endpoint/user/database in DB_* and a securely generated AUTH_SECRET.
# Set secrets in protected backend configuration, never in VITE_* variables.
